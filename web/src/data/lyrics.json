{
  "wanfeng": {
    "title": "晚风",
    "lines": [
      { "t": 0, "text": "晚风吹过 熟悉的街角" },
      { "t": 76, "text": "你的影子 在回忆里摇晃" },
      { "t": 100, "text": "我把心事 折成一只船" },
      { "t": 122, "text": "顺着黄昏 慢慢漂向你" },
      { "t": 146, "text": "如果时间 可以慢一点" },
      { "t": 168, "text": "我想多留 一会儿晚风" },
      { "t": 192, "text": "晚风吹过 熟悉的街角" }
    ]
  },
  "xiaoban": {
    "title": "小半",
    "lines": [
      { "t": 0, "text": "给你的 小半颗心" },
      { "t": 62, "text": "剩下的一半 留给夜晚" },
      { "t": 96, "text": "说不出口的那些话" },
      { "t": 130, "text": "都变成了 沉默的答案" }
    ]
  },
  "qinglang": {
    "title": "晴朗",
    "lines": [
      { "t": 0, "text": "天空很晴朗" },
      { "t": 70, "text": "风把云推向了远方" },
      { "t": 110, "text": "我背着吉他 走在路上" }
    ]
  },
  "qingtian": {
    "title": "晴天",
    "lines": [
      { "t": 0, "text": "故事的小黄花" },
      { "t": 58, "text": "从出生那年就飘着" },
      { "t": 96, "text": "童年的荡秋千" }
    ]
  },
  "riluo": {
    "title": "日落海岸",
    "lines": [
      { "t": 0, "text": "潮水退去 露出整片沙滩" },
      { "t": 64, "text": "夕阳把海面 染成金色" },
      { "t": 108, "text": "我们什么都不说" }
    ]
  }
}
