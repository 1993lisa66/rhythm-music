# 复制为 .env 后填写；.env 已被 git 忽略，不要把真实密钥写进本文件
RHYTHM_JWT_SECRET=change-me-in-production

# 阿里云 OSS（用于封面 / 音频等静态资源，Bucket 私有读，地址由后端签名）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 自定义域名或 CDN，留空则用 https://<bucket>.<endpoint>
OSS_ASSET_HOST=
# 签名有效期（秒，默认 21600 = 6 小时）与过期时间对齐粒度（默认 1800）
OSS_URL_TTL=21600
OSS_URL_ALIGN=1800
